{
  "version": "1.0.15",
  "keywords": [],
  "type": "commonjs",
  "main": "dist/server/index.js",
  "exports": {
    "./package.json": "./package.json",
    "./strapi-admin": {
      "types": "./dist/admin/src/index.d.ts",
      "source": "./admin/src/index.ts",
      "import": "./dist/admin/index.mjs",
      "require": "./dist/admin/index.js",
      "default": "./dist/admin/index.js"
    },
    "./strapi-server": {
      "types": "./dist/server/src/index.d.ts",
      "source": "./server/src/index.ts",
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "strapi-plugin build",
    "watch": "strapi-plugin watch",
    "watch:link": "strapi-plugin watch:link",
    "verify": "strapi-plugin verify",
    "test:ts:front": "run -T tsc -p admin/tsconfig.json",
    "test:ts:back": "run -T tsc -p server/tsconfig.json",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "prepare": "husky"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "openai": "^6.22.0",
    "react-hook-form": "^7.72.1"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@commitlint/cli": "^20.5.0",
    "@strapi/admin": "^5.46.0",
    "@strapi/sdk-plugin": "^5.4.0",
    "@strapi/strapi": "^5.33.3",
    "@strapi/types": "^5.46.0",
    "@strapi/typescript-utils": "^5.33.3",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "eslint": "^9.39.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@strapi/design-system": "^2.0.0-rc.30",
    "@strapi/icons": "^2.0.0-rc.30",
    "@strapi/sdk-plugin": "^5.4.0",
    "@strapi/strapi": "^5.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.3",
    "styled-components": "^6.3.8"
  },
  "lint-staged": {
    "*.{js,ts}": "eslint --fix",
    "*.{js,ts,json,md}": "prettier --write"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "strapi": {
    "kind": "plugin",
    "name": "nui-strapi-chatbot-plugin",
    "displayName": "NUI Chatbot Configuration",
    "description": "An AI-powered FAQ chatbot plugin for Strapi v5. Integrates an intelligent assistant into your admin panel — backed by OpenAI GPT-4o mini and semantic embeddings — so users can get instant answers from your FAQ content. Includes a built-in admin UI for configuration, suggested questions, response templates, and a live chatbot preview."
  },
  "name": "nui-strapi-chatbot-plugin",
  "description": "An AI-powered FAQ chatbot plugin for Strapi v5. Integrates an intelligent assistant into your admin panel — backed by OpenAI GPT-4o mini and semantic embeddings — so users can get instant answers from your FAQ content. Includes a built-in admin UI for configuration, suggested questions, response templates, and a live chatbot preview.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Numentica-UI/strapi-chatbot-plugin.git"
  },
  "author": "app-release-admin@numentica-ui.com",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Numentica-UI/strapi-chatbot-plugin/issues"
  },
  "homepage": "https://github.com/Numentica-UI/strapi-chatbot-plugin#readme"
}
